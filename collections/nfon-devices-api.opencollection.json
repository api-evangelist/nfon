        {
          "info": {
            "name": "Submit Device Bulk Import",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.nfon.com/call-history/tenants/:tenant/devices/bulk",
            "params": [
              {
                "name": "tenant",
                "value": "",
